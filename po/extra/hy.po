#: data/capnet-assist.metainfo.xml.in:10
#: data/io.elementary.capnet-assist.desktop.in:2
msgid "Captive Network Assistant"
msgstr "Մուտքի ցանցի օգնական"

#: data/capnet-assist.metainfo.xml.in:11
#: data/io.elementary.capnet-assist.desktop.in:5
msgid "Connect to captive network portals"
msgstr "Միացում ցանցի մուտքի էջերին"

#: data/capnet-assist.metainfo.xml.in:13
msgid ""
"Log into captive portals—like Wi-Fi networks at coffee shops, airports, and "
"trains—with ease. Captive Network Assistant automatically opens to help you "
"get connected."
msgstr ""
"Հեշտությամբ մուտք գործեք ցանցի մուտքի էջեր՝ օրինակ սրճարանների, "
"օդանավակայանների և գնացքների Wi-Fi ցանցերում։ Մուտքի ցանցի օգնականն ավտոմատ "
"բացվում է՝ օգնելու Ձեզ միանալ։"

#: data/capnet-assist.metainfo.xml.in:42
msgid "elementary, Inc."
msgstr "elementary, Inc."

